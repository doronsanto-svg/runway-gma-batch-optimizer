VEEQO_API_KEY=put_your_key_here
VEEQO_BASE_URL=https://api.veeqo.com
VEEQO_API_CHECK_PAGE_SIZE=5
VEEQO_API_CHECK_STATUS=awaiting_fulfillment
VEEQO_ANALYZE_PAGE_SIZE=100
VEEQO_ANALYZE_STATUS=awaiting_fulfillment
VEEQO_CHANNEL_FILTER=Runway by Christian Siriano
REQUIRE_GMA_SKUS=true
DEFAULT_THRESHOLD=10
PORT=3000
DATA_DIR=./data
PORTAL_USERNAME=runway
PORTAL_PASSWORD=change_this_password
PORTAL_SESSION_SECRET=change_this_long_random_secret
VEEQO_ORDERS_URL=https://app.veeqo.com/orders
# Optional after we confirm Veeqo's private tag-filter URL pattern.
# Use {tag_id} for the Veeqo tag ID, {tag} for URL-encoded tag text, or {tag_raw} for plain tag text.
VEEQO_TAG_FILTER_URL_TEMPLATE=https://app.veeqo.com/orders?tags%5Bany_of%5D={tag_id}
